<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Bump library and package version -->
    <Version>2.0.0</Version>
    <!-- AssemblyVersion is used by binding redirects; keep 4-part -->
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <!-- File version shown in file properties -->
    <FileVersion>2.0.0.0</FileVersion>
    <!-- Informational version (often SemVer with metadata) -->
    <InformationalVersion>2.0.0</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.22.0" />
  </ItemGroup>

</Project>
